    { "id": "create-group", "label": "1. Create Key Group\nand enter group name", "type": "rectangle", "x": 55, "y": 125, "width": 160, "height": 78, "backgroundColor": "#fff0f8", "strokeColor": "#b8487a" },
    { "id": "generate-key", "label": "2. Generate strong key\nand collect full local library", "type": "rectangle", "x": 295, "y": 245, "width": 220, "height": 88, "backgroundColor": "#f6edff", "strokeColor": "#8053c8" },
    { "id": "create-group-request", "label": "3. Send key + complete\nbooks and pages snapshot", "type": "rectangle", "x": 595, "y": 375, "width": 210, "height": 86, "backgroundColor": "#f6edff", "strokeColor": "#8053c8" },
    { "id": "hash-key", "label": "4. Hash key and validate\ncomplete library payload", "type": "diamond", "x": 605, "y": 505, "width": 190, "height": 110, "backgroundColor": "#fff7fc", "strokeColor": "#b8487a" },
    { "id": "transaction", "label": "5. Transaction: create group,\nbooks, pages, and versions", "type": "rectangle", "x": 880, "y": 655, "width": 210, "height": 92, "backgroundColor": "#e9f8f4", "strokeColor": "#177f71" },
    { "id": "group-ready", "label": "6. Group created", "type": "rectangle", "x": 595, "y": 785, "width": 210, "height": 64, "backgroundColor": "#f6edff", "strokeColor": "#8053c8" },
    { "id": "show-key", "label": "7. Show group key\nand switch to Group Library", "type": "rectangle", "x": 295, "y": 895, "width": 220, "height": 82, "backgroundColor": "#fff0f8", "strokeColor": "#b8487a" },
    { "id": "send-key", "label": "8. Send group key", "type": "rectangle", "x": 55, "y": 1015, "width": 160, "height": 64, "backgroundColor": "#fff0f8", "strokeColor": "#b8487a" },
    { "id": "join-key", "label": "9. Enter group key", "type": "rectangle", "x": 1170, "y": 1015, "width": 210, "height": 64, "backgroundColor": "#fff0f8", "strokeColor": "#b8487a" },
    { "id": "join-request", "label": "10. Join request", "type": "rectangle", "x": 595, "y": 1120, "width": 210, "height": 64, "backgroundColor": "#f6edff", "strokeColor": "#8053c8" },
    { "id": "verify-join", "label": "11. Hash key and find group", "type": "diamond", "x": 895, "y": 1215, "width": 180, "height": 100, "backgroundColor": "#e9f8f4", "strokeColor": "#177f71" },
    { "id": "return-library", "label": "12. Return complete\nshared library", "type": "rectangle", "x": 1170, "y": 1350, "width": 210, "height": 76, "backgroundColor": "#f6edff", "strokeColor": "#8053c8" },
    { "id": "remember-key", "label": "13. Remember key in IndexedDB\nuntil member leaves", "type": "rectangle", "x": 1170, "y": 1470, "width": 210, "height": 82, "backgroundColor": "#e9f8f4", "strokeColor": "#177f71" },
    { "id": "edit-page", "label": "14. Edit shared page\nloaded at version N", "type": "rectangle", "x": 1170, "y": 1600, "width": 210, "height": 78, "backgroundColor": "#fff0f8", "strokeColor": "#b8487a" },
    { "id": "save-version", "label": "15. Save Markdown\nwith expected version N", "type": "rectangle", "x": 595, "y": 1715, "width": 210, "height": 78, "backgroundColor": "#f6edff", "strokeColor": "#8053c8" },
    { "id": "version-check", "label": "16. Update only when\ncurrent version = N", "type": "diamond", "x": 895, "y": 1880, "width": 180, "height": 105, "backgroundColor": "#e9f8f4", "strokeColor": "#177f71" },
    { "id": "success-result", "label": "Success: save version N+1\nand refresh other members", "type": "text", "x": 350, "y": 2040, "width": 440, "height": 46, "strokeColor": "#177f71" },
    { "id": "conflict-result", "label": "Conflict: return 409, preserve draft, offer reload or copy to new page", "type": "text", "x": 800, "y": 2040, "width": 560, "height": 46, "strokeColor": "#b8487a" },
    { "id": "group-note", "label": "One shared key gives every member equal create, edit, move, delete, rename, and group-management access.", "type": "text", "x": 360, "y": 2140, "width": 720, "height": 50, "strokeColor": "#725f7c" }
  ],
  "edges": [
    { "from": "create-group", "to": "generate-key", "label": "start" },
